function u64 Archipelago.getZoneActIdOffset()
{
	return ((global.zone+1) * 1000) + (global.act.apparent * 500)
}

function u64 Archipelago.getObjectId_xPos()
{
	return Archipelago.getZoneActIdOffset() + (objA0.position.x/100)
}

function void Archipelago.ApplySpeedUp()
{
	char.bonus_effect |= char.bonus.SPEED_UP
	char.speedup.countdown = 150			// "char.speedup.countdown", decreases every 8 frames
	if (!isMainCharacter(CHARACTER_TAILS))
	{
		setSpeedCapProperties(addressof(global.move.speedcap))			// Address: 0xfffff760
	}
	else
	{
		setSpeedCapProperties(addressof(global.move.speedcap.tails))	// Address: 0xfffffec0
	}

	changeMusicTempo(8)
}

function void Archipelago.ApplyInvincibility()
{
	if (super.active == 0 && super.active.tails == 0)
	{
		char.bonus_effect |= char.bonus.INVINCIBLE
		char.invinc.countdown = 150
		if (!level.boss_encounter && char.drown_countdown > 12)
		{
			playMusic(MUSIC_INVINCIBLE)
		}
		
		u32[0xffffcd7c] = addressof(Invincibility.Init)	// Invincibility stars
		u16[0xffffcd7c + 0x42] = 0xffffb000
	}
}

// Note that this is based on levelselect.characters
function bool Archipelago.IsCharUnlocked(u8 char)
{
	u16 sonic = Archipelago.getItem("Sonic")
	u16 tails = Archipelago.getItem("Tails")
	u16 knuckles = Archipelago.getItem("Knuckles")
	if (char == 0) // Sonic & Tails
	{
		return sonic && tails
	}
	else if (char == 1) // Sonic Alone
	{
		return sonic
	}
	else if (char == 2) // Tails Alone
	{
		return tails
	}
	else if (char == 3) // Knuckles Alone
	{
		return knuckles
	}
	else if (char == 4) // Knuckles & Tails
	{
		return knuckles && tails
	}
	
	return false
}

function u8 Archipelago.GetZoneActsCompleted(u8 zone)
{
	u32 addr = Addr.ZoneProgressStart + zone
	if (u8[addr] <= 0)
	{
		string seed = Archipelago.getSeedName()
		System.loadPersistentData(addr, 4, "s3air_archipelago", stringformat("ZoneProgress%d_%s", zone, seed), false)
	}
	
	u8 count = 0
	u8 val = u8[addr]
    while (val > 0)
	{
		val = val & (val - 1)
		count++
	}
    
	return count
}

function u8 Archipelago.GetZoneRequiredActCount(u8 zone)
{
	if (zone == 0x16 || zone == 0x0c || zone == 0x0a)
	{
		// Hidden Palace, Doomsday, Sky Sanctuary
		return 1
	}
	
	return 2
}

function bool Archipelago.AreAllZonesComplete()
{
	u8 count
	for (u8 i = 0; i < ActSelect.ZONES.length(); i++)
	{
		string name = ActSelect.ZONES[i]
		if (!Archipelago.isZoneAllowed(name))
			continue
		
		u8 zone = ActSelect.ZONE_INTERNAL_IDS[i]
		if (Archipelago.GetZoneActsCompleted(zone) > Archipelago.GetZoneRequiredActCount(zone))
		{
			count++
		}
	}

	return count >= Archipelago.getDataInt("ZoneCount")
}

function bool Archipelago.IsZoneActComplete(u8 zone, u8 act)
{
	u32 addr = Addr.ZoneProgressStart + zone
	if (u8[addr] <= 0)
	{
		string seed = Archipelago.getSeedName()
		System.loadPersistentData(addr, 4, "s3air_archipelago", stringformat("ZoneProgress%d_%s", zone, seed), false)
	}
	
	return u8[addr] & (1 << act) != 0
}

function bool Archipelago.isZoneAllowed(string zone)
{
	if (zone == "Special Stage")
		return true
		
	return base.Archipelago.isZoneAllowed(zone)
}

function bool Archipelago.IsZoneUnlocked(string zone)
{
	if (!Archipelago.isConnected())
		return false
	
	if (zone == "Special Stage")
	{
		return Archipelago.getItem("Progressive Special Stage Unlock")
	}
	
	return Archipelago.getItem("Zone Unlock: " + zone)
}

function string Archipelago.GetZoneNameInternal(u8 id)
{
	if (id == 0x00)
		return "Angel Island Zone"
	else if (id == 0x01)
		return "Hydrocity Zone"
	else if (id == 0x02)
		return "Marble Garden Zone"
	else if (id == 0x03)
		return "Carnival Night Zone"
	else if (id == 0x04)
		return "IceCap Zone"
	else if (id == 0x05)
		return "Launch Base Zone"
	else if (id == 0x06)
		return "Mushroom Hill Zone"
	else if (id == 0x07)
		return "Flying Battery Zone"
	else if (id == 0x08)
		return "Sandopolis Zone"
	else if (id == 0x09)
		return "Lava Reef Zone"
	else if (id == 0x16)
		return "Hidden Palace Zone"
	else if (id == 0x0a)
		return "Sky Sanctuary Zone"
	else if (id == 0x0b)
		return "Death Egg Zone"
	else if (id == 0x0c)
		return "Doomsday Zone"
	
	return stringformat("UNKNOWN Zone [0x%x]", id)
}